[Unit]
Description=EtcFS FUSE Daemon
After=network-online.target etcfuse-meta.service
Wants=network-online.target etcfuse-meta.service
Documentation=https://github.com/anomalyco/etcfuse

[Service]
Type=simple
ExecStart=/usr/local/bin/etcfuse \
  --socket=/run/etcfuse/etcfuse.sock \
  --node-id=%H \
  --log-level=2 \
  /mnt/etcfuse
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
