{
  "title": "EtcFS",
  "uid": "etcfs",
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "FUSE ops/s by operation",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum by (op) (rate(etcfuse_fuse_ops_total[5m]))", "legendFormat": "{{op}}" }
      ]
    },
    {
      "id": 2,
      "title": "FUSE error rate by operation",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum by (op) (rate(etcfuse_fuse_errors_total[5m]))", "legendFormat": "{{op}}" }
      ]
    },
    {
      "id": 3,
      "title": "FUSE op latency p99 by operation",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum by (op, le) (rate(etcfuse_fuse_op_duration_seconds_bucket[5m])))", "legendFormat": "{{op}}" }
      ]
    },
    {
      "id": 4,
      "title": "etcd txn round-trip latency (p50/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(etcfuse_etcd_txn_duration_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.99, rate(etcfuse_etcd_txn_duration_seconds_bucket[5m]))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 5,
      "title": "etcd txns/s by outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "sum by (outcome) (rate(etcfuse_etcd_txn_total[5m]))", "legendFormat": "{{outcome}}" }
      ]
    },
    {
      "id": 6,
      "title": "Block I/O throughput",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "sum by (op) (rate(etcfuse_block_io_bytes_total[5m]))", "legendFormat": "{{op}}" }
      ]
    },
    {
      "id": 7,
      "title": "Arena utilization",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "max": 1, "min": 0, "unit": "percentunit" } },
      "targets": [
        { "expr": "etcfuse_arena_utilization", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 8,
      "title": "Arenas owned",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "targets": [
        { "expr": "etcfuse_arenas_owned", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 9,
      "title": "Membership count",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "targets": [
        { "expr": "etcfuse_membership_count", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 10,
      "title": "Scrub anomalies by type",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "targets": [
        { "expr": "sum by (type) (rate(etcfuse_scrub_anomalies_total[5m]))", "legendFormat": "{{type}}" }
      ]
    },
    {
      "id": 11,
      "title": "Time since last scrub pass",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "time() - etcfuse_scrub_last_run_seconds", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 12,
      "title": "Fencing generation",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
      "targets": [
        { "expr": "etcfuse_fencing_generation", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 13,
      "title": "Nodes fenced by outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "targets": [
        { "expr": "sum by (outcome) (increase(etcfuse_fenced_nodes_total[10m]))", "legendFormat": "{{outcome}}" }
      ]
    }
  ]
}
